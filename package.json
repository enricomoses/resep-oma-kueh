{
  "name": "resep-oma-kueh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "test:boundaries": "node scripts/test-eslint-boundaries.mjs && node scripts/test-server-boundary.mjs",
    "test:e2e": "playwright test",
    "test:db": "supabase test db && node scripts/test-db-concurrency.mjs && npm run test:db:permissions",
    "test:db:permissions": "node --conditions=react-server --import tsx scripts/test-db-permissions.mjs",
    "lint:unused": "knip --no-progress",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:boundaries && npm run lint:unused && npm run format:check && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.5",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.107.1",
    "axios": "1.21.1",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.92.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.0",
    "knip": "6.45.1",
    "prettier": "3.10.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "3.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  }
}
