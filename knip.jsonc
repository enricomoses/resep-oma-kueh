{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Generated CLI output must retain all schema helper exports without hand edits.
  "ignore": ["src/types/database.ts"],
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "tests/**/*.{test,spec}.{ts,tsx,mjs}",
    "tests/fixtures/ui/foundation.tsx",
    "scripts/*.mjs",
  ],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "tests/**/*.{ts,tsx,mjs}",
    "tooling/**/*.mjs",
    "scripts/**/*.mjs",
    "*.config.{ts,mts,mjs}",
  ],
}
