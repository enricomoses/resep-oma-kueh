{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Generated CLI output must retain all schema helper exports without hand edits.
  "ignore": ["src/types/database.ts"],
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "tests/**/*.{test,spec}.{ts,tsx,mjs}",
    "scripts/*.mjs",
  ],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "tests/**/*.{ts,tsx,mjs}",
    "tooling/**/*.mjs",
    "scripts/**/*.mjs",
    "*.config.{ts,mts,mjs}",
  ],
  // Owner's M03 packages reserved for later explicitly-scoped features, not removed by F01.
  "ignoreDependencies": [
    "@hookform/resolvers",
    "react-hook-form",
    "zustand",
    "lucide-react",
    "@axe-core/playwright",
  ],
}
